@inproceedings{olatunde2026development,
  abbr        = {ASBAMI'26},
  title       = {Development of a VLM-RAG-Powered Skin Disease Diagnosis and Information System},
  author      = {Olatunde, Olukemi Victoria and Balogun, Emmanuel Ayomide and Omoniyi, Victoria Ibiyemi},
  booktitle   = {5th African Symposium on Big Data, Analytics and Machine Intelligence (ASBAMI 2026), Federal University of Technology Akure},
  year        = {2026},
  address     = {Akure, Nigeria},
  selected    = {true},
  bibtex_show = {true},
  note        = {Under review},
  abstract    = {Skin diseases have been a major threat and huge contributor to mankind's health and mortality, affecting millions of people globally. Traditional diagnoses like skin scraping and biopsy, though accurate, are often hampered by a shortage of dermatologists, subjectivity in analysis, and, consequently, delays in starting treatment. However, AI diagnostic tools based on Vision-Language Models (VLMs) can produce confident but incorrect information, and existing retrieval-augmented methods draw on static databases not designed for low-resource settings. To overcome these limitations, a VLM-based skin disease diagnosis and information system that provides an accurate preliminary diagnosis using images and factually grounded medical information has been developed. The system creates a dual-component framework that combines a VLM with a Retrieval-Augmented Generation (RAG) system. A Large Language and Vision Assistant (LLaVA) model was fine-tuned using Low-Rank Adaptation (LoRA) on the HAM10000 dataset to specialize it for dermatological image analysis. To reduce hallucination, the system adds a RAG component that retrieves information in real time. Instead of a static database, it performs live web search over trusted sources such as the WHO and Mayo Clinic. The model achieved a macro-F1 of 0.89 on held-out HAM10000 images, and two reviewers rated 94% of its end-to-end responses as factually correct; it also outperformed general models and non-grounded baselines. Through a conversational interface, the system synthesizes its visual analysis with contextual facts retrieved from relevant sources to provide users with a multi-part response that includes potential matching conditions, a concise summary of causes and treatments, and a medical safety disclaimer. This is especially relevant in Africa, where dermatologists are less accessible. However, because training used dermatoscopic, mostly light-skinned images, the system is not yet validated for darker skin tones.}
}
